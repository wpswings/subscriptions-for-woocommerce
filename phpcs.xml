<?xml version="1.0"?>
<ruleset name="Subscriptions for WooCommerce">
    <description>PHPCS ruleset — WordPress Coding Standards + WooCommerce sniffs + PHP compatibility.</description>

    <!-- Scan these paths -->
    <file>.</file>

    <!-- Ignore generated/third-party directories -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress"/>

    <!-- WooCommerce-specific sniffs -->
    <rule ref="WooCommerce"/>

    <!-- PHP version compatibility: require PHP 7.4+ -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Project-specific config -->
    <config name="text_domain" value="subscriptions-for-woocommerce"/>

    <!-- Enforce correct text domain on all i18n calls -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="subscriptions-for-woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Allow long lines where unavoidable (e.g. translatable strings, SQL) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
